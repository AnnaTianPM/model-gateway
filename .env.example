# Environment
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

ADMIN_TOKEN=replace-with-a-long-random-token
GATEWAY_MASTER_KEY=replace-with-a-generated-encryption-key

DATABASE_PATH=/app/data/gateway.db
LOG_LEVEL=INFO
LOG_PROMPT_CONTENT=false
FORCE_RESPONSE_LANGUAGE=off

APP_VERSION_FILE=/app/VERSION
GIT_COMMIT=unknown
DEPLOYMENT_ENV=home-lan

DEFAULT_CLIENT_KEY_NAME=initial-client
TRUST_PROXY_HEADERS=false

# Provider Key examples (leave empty to use Dashboard)
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
